rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Protection globale par défaut
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. UTILISATEURS (/users)
    // Lecture publique des profils, modification réservée au titulaire du compte
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId);

      // Favoris privés de l'utilisateur (/users/{userId}/favorites/{itemId})
      match /favorites/{itemId} {
        allow read, create, delete: if isOwner(userId);
      }

      // Instantanés de valeur (/users/{userId}/valueSnapshots/{snapshotId})
      match /valueSnapshots/{snapshotId} {
        allow read: if true;
        allow create, update, delete: if isOwner(userId);
      }
    }

    // 2. ARTICLES & CLOSET (/items)
    // Lecture publique des articles actifs ou vendus (brouillons visibles uniquement par le vendeur)
    // Création, modification et suppression strictement réservées au vendeur propriétaire
    match /items/{itemId} {
      allow read: if resource.data.status != 'draft' || (isSignedIn() && resource.data.sellerId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }

    // 3. CONVERSATIONS & CHAT (/conversations)
    // Les conversations et leurs messages ne sont accessibles que par leurs 2 participants
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow update, delete: if false;
      }
    }

    // 4. AVIS (/reviews)
    // Lecture publique, création réservée à l'acheteur
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.buyerId == request.auth.uid;
    }

    // 5. SIGNALEMENTS (/reports)
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
